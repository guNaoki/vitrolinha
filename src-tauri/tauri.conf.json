{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitrolinha",
  "version": "0.1.0",
  "identifier": "app.vitrolinha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "Vitrolinha",
        "url": "panel.html",
        "width": 1280,
        "height": 720,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "popup",
        "title": "Vitrolinha — popup",
        "url": "popup.html",
        "width": 676,
        "height": 180,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$TEMP/vitrolinha-art/**", "$APPDATA/shelf/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "guNaoki",
    "copyright": "Copyright (c) 2026 guNaoki",
    "license": "MIT",
    "homepage": "https://github.com/guNaoki/vitrolinha",
    "category": "Music",
    "shortDescription": "Flyout de música com cara de toca-discos vintage",
    "longDescription": "Mostra o que está tocando (qualquer app dos controles de mídia do Windows) num popup ao trocar de faixa e num painel em tela cheia, com cara de vitrola.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
