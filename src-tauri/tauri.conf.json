{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitrolinha",
  "version": "0.1.0",
  "identifier": "app.vitrolinha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "Vitrolinha",
        "url": "panel.html",
        "width": 1280,
        "height": 720,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "popup",
        "title": "Vitrolinha — popup",
        "url": "popup.html",
        "width": 676,
        "height": 180,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$TEMP/vitrolinha-art/**", "$APPDATA/shelf/**"] }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
